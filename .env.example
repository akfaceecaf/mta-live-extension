# Copy to .env and adjust as needed: cp .env.example .env
#
# NOTE: Vite bakes every VITE_* variable into the built extension at build time.
# Anything here is readable by anyone who installs the extension, so never put secrets here.

# Metro-North GTFS-Realtime feed (protobuf), served by the relay in worker/.
# MTA's terms (Item 1) require serving it from a non-MTA server. Pointing this at
# another host also needs a matching host_permissions entry in public/manifest.json.
VITE_MTA_MNR_FEED_URL=https://wheres-my-train-at-relay.wheresmytrainat.workers.dev/mnr
