{
  "manifest_version": 3,
  "name": "Where's My Train At?",
  "version": "0.0.2",
  "version_name": "0.0.2 beta",
  "description": "BETA · Upcoming Metro-North train times in a small popup on any page. Unofficial; not affiliated with the MTA.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Where's My Train At?",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://wheres-my-train-at-relay.wheresmytrainat.workers.dev/*"]
}
